#!/usr/bin/env python3

"""
Keep a Bluetooth headset in HFP for a meeting, then restore A2DP on Ctrl-C.

The AirPods expose their microphone only through HFP/HSP. A known
PipeWire/BlueZ race can leave the eSCO link orphaned when the card is
switched from A2DP to HFP while the headset sends AT+BCC. The source then
exists but delivers silence. This script performs one clean HFP setup,
keeps the card in HFP while it runs, and restores A2DP when interrupted.

It requires bluetoothctl, pw-dump, and wpctl on PATH. It is a workaround,
not a fix; see the nixos-hosts repository's docs/bluetooth-hfp.md.
"""

from __future__ import annotations

import argparse
import atexit
import json
import math
import signal
import subprocess
import sys
import time
from collections.abc import Iterator, Sequence
from dataclasses import dataclass
from inspect import getdoc
from sys import modules
from types import FrameType
from typing import NamedTuple, TypedDict, cast

HFP_PROFILE_PREFIX = "headset-head-unit"
A2DP_PROFILE_PREFIX = "a2dp-sink"
DEFAULT_DEVICE_NAME = "AirPods"
DEFAULT_INTERVAL_SECONDS = 5.0
CARD_LOOKUP_ATTEMPTS = 5
CARD_RETRY_DELAY_SECONDS = 1.0
ACL_RESET_PAUSE_SECONDS = 1.0
ACL_RECONNECT_SETTLE_SECONDS = 4.0
EXPECTED_ERRORS = (OSError, RuntimeError, ValueError, subprocess.SubprocessError)


class Profile(NamedTuple):
    profile_index: int
    name: str


class Card(NamedTuple):
    id: int
    name: str
    description: str
    profiles: tuple[Profile, ...]


PipeWireProps = TypedDict(
    "PipeWireProps",
    {
        "device.name": str,
        "device.description": str,
        "device.alias": str,
        "device.nick": str,
        "media.class": str,
        "node.name": str,
    },
    total=False,
)


class ProfileDict(TypedDict):
    index: int
    name: str


class PipeWireParams(TypedDict, total=False):
    EnumProfile: list[ProfileDict]
    Profile: ProfileDict | list[ProfileDict]


class PipeWireInfo(TypedDict, total=False):
    props: PipeWireProps
    params: PipeWireParams


class PipeWireObject(TypedDict, total=False):
    id: int
    info: PipeWireInfo


def run(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, check=True, capture_output=True, text=True)


def run_optional(*args: str) -> None:
    result = subprocess.run(args, check=False, capture_output=True, text=True)
    if result.returncode != 0:
        print(
            f"warning: {' '.join(args)} exited {result.returncode}: "
            f"{result.stderr.strip()}",
            file=sys.stderr,
        )


def load_pipewire_objects() -> list[PipeWireObject]:
    return cast(list[PipeWireObject], json.loads(run("pw-dump").stdout))


def objects_with_info(
    objects: Sequence[PipeWireObject],
) -> Iterator[tuple[PipeWireObject, PipeWireInfo]]:
    for obj in objects:
        info = obj.get("info")
        if info is not None:
            yield obj, info


def find_mac(device_name: str) -> str:
    matches: list[str] = []
    for line in run("bluetoothctl", "devices").stdout.splitlines():
        parts = line.split(maxsplit=2)
        if (
            len(parts) == 3
            and parts[0] == "Device"
            and device_name.lower() in parts[2].lower()
        ):
            matches.append(parts[1])
    if not matches:
        raise RuntimeError(f"no paired device matching {device_name!r}")
    if len(matches) > 1:
        raise RuntimeError(
            f"{len(matches)} paired devices match {device_name!r}; "
            "pass a more specific --device-name"
        )
    return matches[0]


def find_card(objects: Sequence[PipeWireObject], device_name: str) -> Card:
    for obj, info in objects_with_info(objects):
        props = info.get("props")
        card_id = obj.get("id")
        params = info.get("params")
        if props is None or card_id is None or params is None:
            continue
        name = props.get("device.name", "")
        if not name.startswith("bluez_card."):
            continue
        description = " ".join(
            (
                props.get("device.description", ""),
                props.get("device.alias", ""),
                props.get("device.nick", ""),
                props.get("device.name", ""),
            )
        )
        if device_name.lower() not in description.lower():
            continue
        profiles = tuple(
            Profile(profile_index=profile["index"], name=profile["name"])
            for profile in params.get("EnumProfile", [])
        )
        return Card(
            id=card_id,
            name=name,
            description=description,
            profiles=profiles,
        )
    raise RuntimeError(f"card for {device_name!r} not found; is it connected?")


def find_profile(card: Card, prefix: str) -> Profile:
    for profile in card.profiles:
        if profile.name.startswith(prefix):
            return profile
    raise RuntimeError(f"{card.description} did not offer a {prefix!r} profile")


def find_source(objects: Sequence[PipeWireObject], mac: str) -> int | None:
    prefix = "bluez_input." + mac.replace(":", "_")
    for obj, info in objects_with_info(objects):
        props = info.get("props")
        if props is None or props.get("media.class") != "Audio/Source":
            continue
        if (props.get("node.name") or "").startswith(prefix):
            return obj.get("id")
    return None


def current_profile(objects: Sequence[PipeWireObject], card_id: int) -> str | None:
    for obj, info in objects_with_info(objects):
        if obj.get("id") != card_id:
            continue
        params = info.get("params")
        if params is None:
            continue
        active = params.get("Profile")
        if isinstance(active, dict):
            active = [active]
        for profile in active or []:
            name = profile.get("name")
            if name:
                return name
    return None


def set_profile(card: Card, profile: Profile) -> None:
    run("wpctl", "set-profile", str(card.id), str(profile.profile_index))


def unmute_source(source_id: int) -> None:
    run_optional("wpctl", "set-mute", str(source_id), "0")


def reset_acl(mac: str) -> None:
    print(f"Resetting AirPods ACL ({mac})...")
    run_optional("bluetoothctl", "disconnect", mac)
    time.sleep(ACL_RESET_PAUSE_SECONDS)
    run_optional("bluetoothctl", "connect", mac)
    time.sleep(ACL_RECONNECT_SETTLE_SECONDS)


@dataclass
class AirPodsSession:
    # Mutable on purpose: the signal handler and atexit hook share hfp_active.
    device_name: str = DEFAULT_DEVICE_NAME
    hfp_active: bool = False

    def wait_for_card(self, attempts: int = CARD_LOOKUP_ATTEMPTS) -> Card:
        for _ in range(attempts):
            try:
                return find_card(load_pipewire_objects(), self.device_name)
            except RuntimeError:
                time.sleep(CARD_RETRY_DELAY_SECONDS)
        raise RuntimeError(
            f"card for {self.device_name!r} not found; connect the device and try again"
        )

    def start(self, reconnect: bool) -> None:
        mac = find_mac(self.device_name)
        if reconnect:
            reset_acl(mac)
        card = self.wait_for_card()
        hfp = find_profile(card, HFP_PROFILE_PREFIX)
        set_profile(card, hfp)
        self.hfp_active = True
        source = find_source(load_pipewire_objects(), mac)
        if source is not None:
            unmute_source(source)
        print(f"AirPods switched to HFP (profile index {hfp.profile_index}).")
        print("Leave this command running for the meeting.")
        print("Press Ctrl-C when the meeting ends to restore A2DP.")

    def restore_a2dp(self) -> None:
        if not self.hfp_active:
            return
        self.hfp_active = False
        try:
            card = find_card(load_pipewire_objects(), self.device_name)
            a2dp = find_profile(card, A2DP_PROFILE_PREFIX)
            set_profile(card, a2dp)
        except EXPECTED_ERRORS as exc:
            print(f"Could not restore A2DP automatically: {exc}", file=sys.stderr)
            return
        print("Restored AirPods to A2DP for music playback.")

    def monitor(self, interval: float) -> None:
        last_note = ""
        while True:
            time.sleep(interval)
            note = ""
            try:
                objects = load_pipewire_objects()
                card = find_card(objects, self.device_name)
                current = current_profile(objects, card.id) or "unknown"
                if not current.startswith(HFP_PROFILE_PREFIX):
                    set_profile(card, find_profile(card, HFP_PROFILE_PREFIX))
                    note = (
                        "Re-applied HFP because the AirPods reported profile "
                        f"{current!r}."
                    )
            except (RuntimeError, subprocess.SubprocessError) as exc:
                note = f"warning: {exc}"
            if note and note != last_note:
                print(note, file=sys.stderr)
            last_note = note


def install_signal_handlers(session: AirPodsSession) -> None:
    def handle(_signum: int, _frame: FrameType | None) -> None:
        session.restore_a2dp()
        raise SystemExit(0)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, handle)


def positive_seconds(value: str) -> float:
    seconds = float(value)
    if not math.isfinite(seconds) or seconds <= 0:
        raise argparse.ArgumentTypeError(
            f"expected a positive, finite number of seconds, got {value!r}"
        )
    return seconds


def main() -> int:
    parser = argparse.ArgumentParser(description=getdoc(modules[__name__]))
    parser.add_argument(
        "--device-name",
        default=DEFAULT_DEVICE_NAME,
        help=f"Bluetooth device name to match (default: {DEFAULT_DEVICE_NAME})",
    )
    parser.add_argument(
        "--no-reconnect",
        action="store_true",
        help="do not reset the ACL before selecting HFP",
    )
    parser.add_argument(
        "--interval",
        type=positive_seconds,
        default=DEFAULT_INTERVAL_SECONDS,
        help=f"seconds between profile checks (default: {DEFAULT_INTERVAL_SECONDS:g})",
    )
    args = parser.parse_args()
    device_name: str = args.device_name
    reconnect: bool = not args.no_reconnect
    interval: float = args.interval

    session = AirPodsSession(device_name=device_name)
    install_signal_handlers(session)
    atexit.register(session.restore_a2dp)
    try:
        session.start(reconnect=reconnect)
        session.monitor(interval)
    except EXPECTED_ERRORS as exc:
        print(f"airpods-meeting: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
