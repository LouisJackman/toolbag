#!/usr/bin/env python3

"""
For all images with a semantic version tag (e.g. 0.0.1), delete all but the
latest for each unique image name.
"""

from argparse import ArgumentParser
from inspect import getdoc
from itertools import groupby
import re
from subprocess import SubprocessError, PIPE, Popen
from sys import modules
from typing import Iterable, Mapping

from utils import SemanticVersion, container, container_runtime


ArgumentParser(description=getdoc(modules[__name__])).parse_args()

VERSION_PATTERN = re.compile(r"^ (\d+) \. (\d+) \. (\d+) $", re.VERBOSE)


def tagged_version(line: str) -> Iterable[tuple[str, SemanticVersion]]:
    """Yield ``(name, version)`` when the line's tag parses as a version."""
    name, tag, *_ = line.split()
    if match := VERSION_PATTERN.match(tag):
        yield name, SemanticVersion(*(int(x) for x in match.groups()))


def extract_outdated_images(stdout: Iterable[bytes]) -> Mapping[str, set[SemanticVersion]]:
    tagged = sorted(entry for raw in stdout for entry in tagged_version(raw.decode()))
    versions_by_name = {
        name: {version for _, version in group}
        for name, group in groupby(tagged, key=lambda pair: pair[0])
    }
    return {
        name: versions - {max(versions)}
        for name, versions in versions_by_name.items()
    }


def delete_images(images: Mapping[str, set[SemanticVersion]]) -> None:
    individual_images = [
        f"{name}:{version}" for name, versions in images.items() for version in versions
    ]
    if individual_images:
        container("rmi", *individual_images)


with Popen(
    [container_runtime(), "images", "--format", "{{.Repository}} {{.Tag}}"],
    stdout=PIPE,
) as proc:
    if proc.stdout:
        outdated = extract_outdated_images(proc.stdout)
        delete_images(outdated)
    if proc.wait() != 0:
        raise SubprocessError()
