#!/usr/bin/env python3

"""
For all images with a semantic version tag (e.g. 0.0.1), delete all but the
latest for each unique image name from a registry.

``crane`` (google/go-containerregistry) enumerates the repositories in a registry
(``crane catalog``), lists their tags (``crane ls``), and deletes them
(``crane delete``).
"""

from argparse import ArgumentParser
from inspect import getdoc
import re
from subprocess import run
from sys import modules
from typing import Iterable

from utils import SemanticVersion


parser = ArgumentParser(description=getdoc(modules[__name__]))
parser.add_argument(
    "registry",
    nargs="?",
    help="The registry to clean.",
    default="localhost:5000",
)
args = parser.parse_args()

REGISTRY: str = args.registry
bypass_tls = (
    REGISTRY.startswith("localhost")
    or REGISTRY.startswith("127.0.0.1")
    or REGISTRY.startswith("[::1]")
)
# crane's global --insecure skips TLS verification for local registries.
CRANE = ["crane", "--insecure"] if bypass_tls else ["crane"]
del bypass_tls
del args

VERSION_PATTERN = re.compile(r"^ (\d+) \. (\d+) \. (\d+) $", re.VERBOSE)


def crane(*arguments: str) -> list[str]:
    """Run ``crane arguments...`` and return its output split into fields."""
    completed = run(CRANE + list(arguments), check=True, capture_output=True, text=True)
    return completed.stdout.split()


def parse_versions(tags: Iterable[str]) -> set[SemanticVersion]:
    return {
        SemanticVersion(*(int(x) for x in match.groups()))
        for tag in tags
        if (match := VERSION_PATTERN.match(tag))
    }


def delete_old_tags(repository: str) -> None:
    tags = crane("ls", f"{REGISTRY}/{repository}")
    versions = parse_versions(tags)
    if len(versions) < 2:
        return
    for version in versions - {max(versions)}:
        run(CRANE + ["delete", f"{REGISTRY}/{repository}:{version}"], check=True)


for repository in crane("catalog", REGISTRY):
    delete_old_tags(repository)
