#!/usr/bin/env python3

"""
Local Docker installations like Docker for Mac support local Kubernetes
clusters. However, they often leave behind old supporting images on updates.
This cleans them out but assumes the latest images are in use by the cluster and
so won't be deleted by Docker.
"""

from argparse import ArgumentParser
from inspect import getdoc
from subprocess import SubprocessError, Popen, PIPE
from sys import modules
from typing import Iterable

from utils import container, container_runtime


ArgumentParser(description=getdoc(modules[__name__])).parse_args()


def parse_output(out: Iterable[bytes]) -> Iterable[str]:
    for raw in out:
        line = raw.decode()
        if ("k8s" in line) or ("kube-" in line):
            name, tag, *_ = line.split()
            yield f"{name}:{tag}"


# This targets Docker Desktop's bundled Kubernetes, which Podman does not
# provide; a Podman context cannot clean images it never created. Podman is
# tried first, so a host with both runtimes must select Docker explicitly.
runtime = container_runtime()
if runtime != "docker":
    raise SystemExit(
        "clean-old-local-k8s-images targets Docker Desktop's local Kubernetes; "
        "set CONTAINER_ENGINE=docker on a host that provides it"
    )

with Popen(
    [runtime, "images", "--format", "{{.Repository}} {{.Tag}}"],
    stdout=PIPE,
) as proc:
    if not proc.stdout:
        raise RuntimeError("missing expected output from the container runtime")
    images = list(parse_output(proc.stdout))
    if proc.wait() != 0:
        raise SubprocessError()
if images:
    container("rmi", *images)
